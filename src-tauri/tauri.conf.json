{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4Nier Patrimônio Auditável",
  "version": "../package.json",
  "identifier": "io.github.marcelofournier.carteiraauditavel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "4Nier · Patrimônio Auditável",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Controle de investimentos com rentabilidade auditável",
    "copyright": "GPL-3.0-or-later",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "customLanguageFiles": {
          "PortugueseBR": "nsis/PortugueseBR.nsh"
        },
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQTQxMDYwN0Y2NUVEQjQKUldTMDdXVi9ZQkNrdktJRzlicERFQkUxcjVUME1YdHVId3RxRXhwZWNFSWxOeHpRZ1R3Unk2RW8K",
      "endpoints": [
        "https://github.com/4nier-app/patrimonio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
